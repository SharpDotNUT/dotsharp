{
  "name": "@sharpdotnut/dotsharp",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && pnpm run build:css",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/style.css --minify",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "unplugin-vue": "^8.0.0",
    "vite-plus": "1.4.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
