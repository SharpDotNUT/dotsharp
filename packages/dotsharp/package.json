{
  "name": "@sharpdotnut/dotsharp",
  "version": "1.1.0",
  "description": "dotsharp——适用于 Vue 3 的组件库，内置明暗主题切换。",
  "keywords": [
    "component-library",
    "components",
    "design-system",
    "material-3",
    "material-design",
    "tailwind",
    "tailwindcss",
    "ui",
    "vue",
    "vue3"
  ],
  "homepage": "https://dotsharp.sharpdotnut.com/",
  "bugs": {
    "url": "https://github.com/SharpDotNUT/dotsharp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SharpDotNUT/dotsharp.git",
    "directory": "packages/dotsharp"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && pnpm run build:css",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/style.css --minify",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.4",
    "@material/material-color-utilities": "0.3.0"
  },
  "devDependencies": {
    "@iconify-icons/material-symbols": "^2.0.7",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "unplugin-vue": "^8.0.0",
    "vite-plus": "1.4.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
